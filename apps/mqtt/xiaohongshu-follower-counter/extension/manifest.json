{
  "manifest_version": 3,
  "name": "TC002 Xiaohongshu Follower Count (local)",
  "version": "0.2.0",
  "description": "Reads the follower count from a Xiaohongshu user profile locally and sends it to the TC002.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/user/profile/*",
        "https://xiaohongshu.com/user/profile/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extractor.js"],
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ]
    }
  ],
  "options_page": "options.html"
}
